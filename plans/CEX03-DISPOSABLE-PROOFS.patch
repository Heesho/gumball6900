+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.26;
+
+import { IERC20 } from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+
+import { Resonance } from "../../../src/core/Resonance.sol";
+import { SignalGBX } from "../../../src/core/SignalGBX.sol";
+import { ProtocolFixture } from "../utils/ProtocolFixture.sol";
+
+/// @title CEX03RollbackProof
+/// @notice Proves discovery metadata remains atomic with the canonical signal and GBX custody ledgers.
+contract CEX03RollbackProof is ProtocolFixture {
+    uint256 private constant TARGET_SIGNAL = 40 ether;
+    uint256 private constant GBX_SIGNAL = 60 ether;
+
+    function setUp() external {
+        _deployProtocol();
+        _mintTestGBX(ALICE, 100 ether);
+    }
+
+    /// @notice A failed final GBX return unwinds every preceding scalar-removal transition, including set deletion.
+    function test_FinalReturnFailureRollsBackMembershipCanonicalWeightReceiptVotesAndCustody() external {
+        _signal(ALICE, address(targetStrategy), 100 ether);
+
+        uint256 membershipCountBefore = resonance.signalStrategyCount(ALICE);
+        address membershipBefore = resonance.signalStrategyAt(ALICE, 0);
+        uint256 accountWeightBefore = targetBribe.signalWeightOf(ALICE);
+        uint256 strategyWeightBefore = targetBribe.totalSignalWeight();
+        uint256 activeWeightBefore = resonance.totalSignalWeight();
+        uint256 receiptBalanceBefore = signalGBX.balanceOf(ALICE);
+        uint256 receiptSupplyBefore = signalGBX.totalSupply();
+        uint256 votesBefore = signalGBX.getVotes(ALICE);
+        address delegateBefore = signalGBX.delegates(ALICE);
+        uint256 userGBXBefore = gbx.balanceOf(ALICE);
+        uint256 custodyBefore = gbx.balanceOf(address(signalGBX));
+
+        assertEq(membershipCountBefore, 1, "precondition: one membership");
+        assertEq(membershipBefore, address(targetStrategy), "precondition: target membership");
+        assertEq(accountWeightBefore, 100 ether, "precondition: final scalar removal");
+
+        bytes memory failure = abi.encodeWithSignature("Error(string)", "GBX_RETURN_REVERTED");
+        vm.mockCallRevert(address(gbx), abi.encodeWithSelector(IERC20.transfer.selector, ALICE, 100 ether), failure);
+
+        vm.prank(ALICE);
+        vm.expectRevert(failure);
+        signalGBX.removeSignal(address(targetStrategy), 100 ether);
+        vm.clearMockedCalls();
+
+        assertEq(resonance.signalStrategyCount(ALICE), membershipCountBefore, "membership count must roll back");
+        assertEq(resonance.signalStrategyAt(ALICE, 0), membershipBefore, "membership address must roll back");
+        assertEq(targetBribe.signalWeightOf(ALICE), accountWeightBefore, "account Bribe weight must roll back");
+        assertEq(targetBribe.totalSignalWeight(), strategyWeightBefore, "Strategy Bribe weight must roll back");
+        assertEq(resonance.totalSignalWeight(), activeWeightBefore, "active total must roll back");
+        assertEq(signalGBX.balanceOf(ALICE), receiptBalanceBefore, "receipt balance must roll back");
+        assertEq(signalGBX.totalSupply(), receiptSupplyBefore, "receipt supply must roll back");
+        assertEq(signalGBX.getVotes(ALICE), votesBefore, "votes must roll back");
+        assertEq(signalGBX.delegates(ALICE), delegateBefore, "delegate must remain unchanged");
+        assertEq(gbx.balanceOf(ALICE), userGBXBefore, "user GBX must roll back");
+        assertEq(gbx.balanceOf(address(signalGBX)), custodyBefore, "GBX custody must roll back");
+    }
+
+    /// @notice A later invalid allocation unwinds an earlier final Bribe removal and membership deletion in the batch.
+    function test_BatchLaterFailureRollsBackEarlierFinalMembershipAndCanonicalRemoval() external {
+        SignalGBX.Allocation[] memory deposits = new SignalGBX.Allocation[](2);
+        deposits[0] = SignalGBX.Allocation({ strategy: address(targetStrategy), amount: TARGET_SIGNAL });
+        deposits[1] = SignalGBX.Allocation({ strategy: address(gbxStrategy), amount: GBX_SIGNAL });
+
+        vm.startPrank(ALICE);
+        gbx.approve(address(signalGBX), TARGET_SIGNAL + GBX_SIGNAL);
+        signalGBX.addSignalMany(deposits);
+        vm.stopPrank();
+
+        uint256 membershipCountBefore = resonance.signalStrategyCount(ALICE);
+        address firstMembershipBefore = resonance.signalStrategyAt(ALICE, 0);
+        address secondMembershipBefore = resonance.signalStrategyAt(ALICE, 1);
+        uint256 targetAccountWeightBefore = targetBribe.signalWeightOf(ALICE);
+        uint256 targetStrategyWeightBefore = targetBribe.totalSignalWeight();
+        uint256 gbxAccountWeightBefore = gbxBribe.signalWeightOf(ALICE);
+        uint256 gbxStrategyWeightBefore = gbxBribe.totalSignalWeight();
+        uint256 activeWeightBefore = resonance.totalSignalWeight();
+        uint256 receiptBalanceBefore = signalGBX.balanceOf(ALICE);
+        uint256 receiptSupplyBefore = signalGBX.totalSupply();
+        uint256 votesBefore = signalGBX.getVotes(ALICE);
+        uint256 userGBXBefore = gbx.balanceOf(ALICE);
+        uint256 custodyBefore = gbx.balanceOf(address(signalGBX));
+
+        assertEq(membershipCountBefore, 2, "precondition: two memberships");
+        assertEq(targetAccountWeightBefore, TARGET_SIGNAL, "precondition: first removal is final");
+
+        SignalGBX.Allocation[] memory removals = new SignalGBX.Allocation[](2);
+        removals[0] = SignalGBX.Allocation({ strategy: address(targetStrategy), amount: TARGET_SIGNAL });
+        removals[1] = SignalGBX.Allocation({ strategy: address(gbxStrategy), amount: GBX_SIGNAL + 1 });
+
+        vm.prank(ALICE);
+        vm.expectRevert(
+            abi.encodeWithSelector(
+                Resonance.InsufficientSignal.selector, address(gbxStrategy), GBX_SIGNAL, GBX_SIGNAL + 1
+            )
+        );
+        signalGBX.removeSignalMany(removals);
+
+        assertEq(resonance.signalStrategyCount(ALICE), membershipCountBefore, "membership count must roll back");
+        assertEq(resonance.signalStrategyAt(ALICE, 0), firstMembershipBefore, "first membership must roll back");
+        assertEq(resonance.signalStrategyAt(ALICE, 1), secondMembershipBefore, "second membership must persist");
+        assertEq(targetBribe.signalWeightOf(ALICE), targetAccountWeightBefore, "first account weight must roll back");
+        assertEq(targetBribe.totalSignalWeight(), targetStrategyWeightBefore, "first total weight must roll back");
+        assertEq(gbxBribe.signalWeightOf(ALICE), gbxAccountWeightBefore, "second account weight must persist");
+        assertEq(gbxBribe.totalSignalWeight(), gbxStrategyWeightBefore, "second total weight must persist");
+        assertEq(resonance.totalSignalWeight(), activeWeightBefore, "active total must roll back");
+        assertEq(signalGBX.balanceOf(ALICE), receiptBalanceBefore, "receipt balance must remain unchanged");
+        assertEq(signalGBX.totalSupply(), receiptSupplyBefore, "receipt supply must remain unchanged");
+        assertEq(signalGBX.getVotes(ALICE), votesBefore, "votes must remain unchanged");
+        assertEq(gbx.balanceOf(ALICE), userGBXBefore, "user GBX must remain unchanged");
+        assertEq(gbx.balanceOf(address(signalGBX)), custodyBefore, "GBX custody must remain unchanged");
+    }
+
+    function _signal(address account, address strategy, uint256 amount) private {
+        vm.startPrank(account);
+        gbx.approve(address(signalGBX), amount);
+        signalGBX.addSignal(strategy, amount);
+        vm.stopPrank();
+    }
+}
diff --git a/packages/contracts/test/minimal/audit-gauntlet/CEX03FaultFuzzProof.t.sol b/packages/contracts/test/minimal/audit-gauntlet/CEX03FaultFuzzProof.t.sol
