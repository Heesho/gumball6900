# Copy to .env for local-only app/test use. Never commit populated secrets or provider URLs containing credentials.
# The deployment runner intentionally does not autoload .env; remote operators inject only required values through
# their reviewed launcher or secret manager after selecting the exact authorization ceremony.

# Robinhood Chain RPCs. Use archive-capable authenticated providers for forks, deployment, indexing, and production.
# Public references (rate limited):
#   mainnet https://rpc.mainnet.chain.robinhood.com
#   testnet https://rpc.testnet.chain.robinhood.com
ROBINHOOD_MAINNET_RPC_URL=
ROBINHOOD_TESTNET_RPC_URL=
ROBINHOOD_MAINNET_ARCHIVE_RPC_URL=
ROBINHOOD_TESTNET_ARCHIVE_RPC_URL=
# Mainnet fork evidence is emitted only by export-mainnet-fork-context.mjs from a prepared signed release manifest and
# its hash-bound config snapshot. The exporter supplies the block/hash and all 50 dependency evidence values together.
ROBINHOOD_MAINNET_FORK_BLOCK=
ROBINHOOD_MAINNET_FORK_BLOCK_HASH=
# Exact archive block chosen by the operator when generating a provisional wrapped-BTC bridge candidate.
ROBINHOOD_MAINNET_WBTC_OBSERVATION_BLOCK=
ROBINHOOD_TESTNET_FORK_BLOCK=
ROBINHOOD_TESTNET_FORK_BLOCK_HASH=
ROBINHOOD_TESTNET_OBSERVED_AT_UNIX=
ROBINHOOD_TESTNET_PARENT_BLOCK_HASH=

# Required reviewed testnet fork dependencies and code hashes for direct local invocation. Release/main CI ignores
# these values and loads the build-bound config file instead. Leave unset until official evidence resolves them; an
# RPC-backed testnet suite fails rather than producing chain-only evidence. The harness never substitutes mainnet.
ROBINHOOD_TESTNET_USDG_ADDRESS=
ROBINHOOD_TESTNET_USDG_CODE_HASH=
ROBINHOOD_TESTNET_WETH_ADDRESS=
ROBINHOOD_TESTNET_WETH_CODE_HASH=
ROBINHOOD_TESTNET_POOL_MANAGER_ADDRESS=
ROBINHOOD_TESTNET_POOL_MANAGER_CODE_HASH=
ROBINHOOD_TESTNET_POSITION_MANAGER_ADDRESS=
ROBINHOOD_TESTNET_POSITION_MANAGER_CODE_HASH=
ROBINHOOD_TESTNET_PERMIT2_ADDRESS=
ROBINHOOD_TESTNET_PERMIT2_CODE_HASH=

# Repository deployment commands intentionally accept no signer secret through the environment. Nonlocal EOA phases
# fail closed. The exact-plan rehearsal uses an unlocked chain-31337 account by default; its optional local test-key
# file is supplied directly to the generated runner only after verification.
LOCAL_REHEARSAL_RPC_URL=http://127.0.0.1:8545
ROBINHOOD_BLOCKSCOUT_API_KEY=
ROBINHOOD_TESTNET_BLOCKSCOUT_API_KEY=
PROTOCOL_TIMELOCK_MULTISIG_ADDRESS=
EMERGENCY_GUARDIAN_MULTISIG_ADDRESS=
GENESIS_LIQUIDITY_BACKER_ADDRESS=

# Manifest tooling. MANIFEST_OBSERVED_AT must be an explicit RFC-3339 timestamp for deterministic output. Generated
# outputs stay under the ignored generated/ directory until an independently reviewed candidate is committed.
MANIFEST_OBSERVED_AT=
ASSET_MANIFEST_OUTPUT=packages/config/deployments/generated/robinhood-mainnet.assets.json
EXPECTED_BYTECODE_HASHES_PATH=
BYTECODE_VERIFICATION_OUTPUT=packages/config/deployments/generated/robinhood-mainnet.bytecode.json
DEPLOYMENT_MANIFEST_PATH=

# Pre-broadcast authorization inputs must be absolute paths outside the git worktree. The replay ledger must be
# protected, persistent, and shared by every deployment operator. DEPLOYMENT_EXECUTION_MODE is set by the reviewed
# wrapper; setting it manually never substitutes for cryptographic preflight.
DEPLOYMENT_AUTHORIZATION_PATH=
DEPLOYMENT_AUTHORIZATION_LEDGER_PATH=
DEPLOYMENT_CONFIG_PATH=
DEPLOYMENT_STATE_PATH=
# Schema-v2 permissioned production verification requires the exact three repository-confined JSON evidence files
# declared by releaseEvidence.permissionedPool. Schema v1 and unrestricted verification ignore these values.
RELEASE_PERMISSIONED_POOL_GRAPH_PATH=
RELEASE_PERMISSIONED_POOL_OFFICIAL_SOURCE_BUILD_PATH=
RELEASE_PERMISSIONED_POOL_FORK_REHEARSAL_PATH=
# Read-only, role-specific Safe evidence capture. Reuse an explicit block number when capturing both roles. The
# authorized schedule wrapper accepts the records via --protocol-admin-safe-evidence and
# --emergency-guardian-safe-evidence, then writes its unsigned proposal via --safe-bundle.
SAFE_CONTROL_PLANE_BLOCK_NUMBER=
SAFE_CONTROL_PLANE_EVIDENCE_OUTPUT=

# Fail-closed launch decisions. These placeholders are intentionally not deployable values.
WRAPPED_BTC_STATUS=UNRESOLVED
ROBINHOOD_TESTNET_DEPENDENCIES_STATUS=UNRESOLVED
COMPLIANCE_MODE=UNRESOLVED
ELIGIBILITY_MODULE_ADDRESS=

# CI must remain fixture-backed. A live drift check is a manual deployment/release action only.
RUN_LIVE_MANIFEST_CHECK=false
