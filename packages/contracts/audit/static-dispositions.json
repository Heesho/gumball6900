{
  "version": 2,
  "evidenceStatus": "Historical internal dispositions from 2026-08-16; not regenerated after ADR 0044, ADR 0046, or ADR 0047. Entries for the rewritten Resonance, Strategy, BribeRouter, and Bribe reward/settlement surfaces were removed and require fresh analysis; this is not current-tree release evidence.",
  "reviewedAt": "2026-08-16",
  "expiresAt": "2026-08-23T23:59:59Z",
  "reviewers": {
    "internal-protocol-security": {
      "name": "GUM BALL 6900 protocol engineering",
      "role": "Internal protocol security review; not an independent audit"
    }
  },
  "rationales": {
    "slither:assembly": "Reviewed EIP-1153 Fund duplicate-mark primitives use domain-separated keys and explicit success-path clearing; no arbitrary memory or storage access exists.",
    "slither:calls-loop": "Reported calls are in fixed-sixteen, scalar-escapable, caller-selected, or explicit convenience loops whose maximum gas and atomicity are documented.",
    "slither:incorrect-equality": "Each equality is an exact empty-amount, zero-weight, or unchanged-index state-machine sentinel, not an access-control or probabilistic comparison.",
    "slither:redundant-statements": "The named ERC-721 receiver parameters are deliberately ignored while retained in the generated ABI and NatSpec; authorization uses manager, depositor, token, pool, and custody state.",
    "slither:reentrancy-benign": "Reported factory and Bribe callbacks are guarded, constructor-isolated, or occur before graph activation; no callback can retain a partially written authorized state.",
    "slither:reentrancy-no-eth": "Reported token interactions occur beneath nonReentrant entry points with effects-first accounting and atomic rollback of every later index or epoch write.",
    "slither:timestamp": "Timestamps intentionally drive fixed emission epochs, seven-day reward streams, bounded reverse Dutch prices, and caller deadlines with tested boundary semantics.",
    "slither:unused-return": "The ignored convenience values are non-authoritative; typed downstream calls revert on failure and exact token deltas independently prove complete routing.",
    "aderyn:centralization-risk": "Findings identify the intentionally minimal Resonance administration and its controlled factories; production deployment remains blocked until ownership is transferred to a separately reviewed external governance executor.",
    "aderyn:costly-loop": "Loops are capped at sixteen, caller-selected, incrementally bounded, or paired with scalar alternatives; worst-case gas is measured against the pinned chain limit.",
    "aderyn:large-numeric-literal": "Reported values are named fixed supply, emission, precision, fee, price, or time constants pinned by tests and independent economic fixtures.",
    "aderyn:literal-instead-of-constant": "The two literals are fixed positions in the pinned PositionManager return tuple and are tested against canonical pool and position identity.",
    "aderyn:local-variable-shadowing": "Reported constructor parameters and local currency values are explicitly qualified or scoped and compile to unambiguous immutable assignments.",
    "aderyn:redundant-statement": "ERC-721 operator and data are intentionally ignored but named for ABI and NatSpec clarity; neither is an authorization input.",
    "aderyn:reentrancy-state-change": "Every reported state transition is constructor-isolated or beneath nonReentrant checks-effects-interactions with exact-delta verification and adversarial rollback tests.",
    "aderyn:require-revert-in-loop": "Batch and selected-token operations intentionally revert atomically; fixed-sixteen and caller-selected loops retain scalar or omission paths for broken tokens.",
    "aderyn:storage-array-memory-edit": "Mine._price intentionally accepts a read-only memory snapshot so both the replacement path's prior-slot copy and the public price view can share identical auction arithmetic; no caller expects it to update storage.",
    "aderyn:unchecked-return": "Reported returns are convenience values or revert-only typed validations; authoritative completion is enforced by revert and exact observed token deltas.",
    "aderyn:unused-public-function": "Reported functions are intentional public preview, accounting, pool-key, and custody APIs used by offchain consumers and permissionless monitoring."
  },
