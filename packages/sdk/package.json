{
  "name": "@gumball-6900/sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "abi:check": "node scripts/generate-abis.mjs --check",
    "abi:generate": "node scripts/generate-abis.mjs",
    "build": "pnpm run clean && tsc -p tsconfig.build.json && node scripts/bundle-uniswap.mjs",
    "clean": "rm -rf dist coverage",
    "docs:check": "node scripts/generate-docs.mjs --check",
    "docs:generate": "node scripts/generate-docs.mjs",
    "lint": "tsc --noEmit",
    "pack:check": "pnpm run build && node scripts/check-package.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@uniswap/sdk-core": "7.19.0",
    "@uniswap/v3-sdk": "3.31.1",
    "@uniswap/v4-periphery": "1.0.3",
    "@uniswap/v4-sdk": "2.3.1",
    "jsbi": "3.2.5",
    "viem": "2.55.10",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@gumball-6900/config": "workspace:*",
    "esbuild": "0.28.1",
    "prettier": "3.6.2",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.12.0",
    "typescript": "5.9.2",
    "vitest": "4.1.10"
  }
}
