{
  "name": "gumball-6900-monorepo",
  "version": "0.1.0",
  "private": true,
  "license": "BUSL-1.1",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": "22.23.1",
    "pnpm": "10.14.0"
  },
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean",
    "dev": "turbo run dev --parallel",
    "docker:build": "docker build --file apps/web/Dockerfile --tag gumball-6900-web:local .",
    "docs:check": "pnpm --filter @gumball-6900/contracts docs:check && pnpm --filter @gumball-6900/sdk docs:check",
    "docs:generate": "pnpm --filter @gumball-6900/contracts docs:generate && pnpm --filter @gumball-6900/sdk docs:generate",
    "docs:whitepaper": "node docs/whitepaper/build.mjs",
    "docs:one-pager": "node docs/one-pager/gumball6900/build.mjs",
    "format": "prettier --write . && pnpm --filter @gumball-6900/contracts fmt",
    "format:check": "prettier --check . && pnpm --filter @gumball-6900/contracts fmt:check",
    "lint": "pnpm run lint:eslint && turbo run lint",
    "lint:eslint": "eslint .",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "config:test": "pnpm --filter @gumball-6900/config test",
    "config:manifest:assets": "pnpm --filter @gumball-6900/config manifest:assets",
    "config:manifest:assets:reviewed:validate": "pnpm --filter @gumball-6900/config manifest:assets:reviewed:validate",
    "config:manifest:wrapped-btc": "pnpm --filter @gumball-6900/config manifest:wrapped-btc",
    "config:manifest:bytecode": "pnpm --filter @gumball-6900/config manifest:bytecode",
    "config:manifest:validate": "pnpm --filter @gumball-6900/config manifest:validate",
    "config:manifest:archive:validate": "pnpm --filter @gumball-6900/config manifest:archive:validate",
    "config:nightly:mainnet:pin": "pnpm --filter @gumball-6900/config nightly:mainnet:pin",
    "config:fork:evidence:live:verify": "pnpm --filter @gumball-6900/config fork:evidence:live:verify",
    "config:authorization:validate": "pnpm --filter @gumball-6900/config authorization:validate",
    "config:authorization:archive:validate": "pnpm --filter @gumball-6900/config authorization:archive:validate",
    "config:authorization:hash-json": "pnpm --filter @gumball-6900/config authorization:hash-json",
    "contracts:compile": "pnpm --filter @gumball-6900/contracts compile",
    "contracts:test": "pnpm --filter @gumball-6900/contracts test",
    "contracts:test:hardhat": "pnpm --filter @gumball-6900/contracts test:hardhat",
    "sdk:test": "pnpm --filter @gumball-6900/sdk test",
    "sdk:abi:check": "pnpm --filter @gumball-6900/sdk abi:check",
    "sdk:abi:generate": "pnpm --filter @gumball-6900/sdk abi:generate",
    "sdk:pack:check": "pnpm --filter @gumball-6900/sdk pack:check",
    "simulations:test": "pnpm --filter @gumball-6900/simulations test",
    "simulations:fixtures:check": "pnpm --filter @gumball-6900/simulations fixtures:check",
    "simulations:charts:check": "pnpm --filter @gumball-6900/simulations charts:check",
    "subgraph:codegen": "pnpm --filter @gumball-6900/subgraph codegen",
    "subgraph:abi:check": "pnpm --filter @gumball-6900/subgraph abi:check",
    "subgraph:build": "pnpm --filter @gumball-6900/subgraph build",
    "subgraph:test": "pnpm --filter @gumball-6900/subgraph test",
    "web:test": "pnpm --filter @gumball-6900/web test",
    "web:test:e2e": "pnpm --filter @gumball-6900/web test:e2e"
  },
  "devDependencies": {
    "@gumball-6900/eslint-config": "workspace:*",
    "@types/node": "22.18.0",
    "eslint": "9.39.5",
    "prettier": "3.6.2",
    "prettier-plugin-solidity": "2.1.0",
    "turbo": "2.10.8",
    "typescript": "5.9.2"
  },
  "pnpm": {
    "overrides": {
      "@coinbase/cdp-sdk@1.54.0>axios": "1.19.0",
      "@graphprotocol/graph-cli@0.98.1>decompress": "npm:@xhmikosr/decompress@11.1.3",
      "@graphprotocol/graph-cli@0.98.1>glob": "11.1.0",
      "@graphprotocol/graph-cli@0.98.1>immutable": "5.1.8",
      "@graphprotocol/graph-cli@0.98.1>js-yaml": "4.3.1",
      "@graphprotocol/graph-cli@0.98.1>undici": "7.29.0",
      "@graphprotocol/graph-cli@0.98.1>yaml": "2.8.3",
      "@ethersproject/providers@5.8.0>ws": "8.21.0",
      "@nomicfoundation/hardhat-verify@2.1.3>undici": "6.28.0",
      "@nomicfoundation/ignition-core@0.15.15>lodash": "4.18.1",
      "apisauce@2.1.6>axios": "0.33.0",
      "ethjs-unit@0.1.6>bn.js": "4.12.3",
      "gluegun@5.2.0>cross-spawn": "7.0.6",
      "gluegun@5.2.0>ejs": "3.1.10",
      "gluegun@5.2.0>semver": "7.8.5",
      "hardhat@2.29.0>adm-zip": "0.6.0",
      "hardhat@2.29.0>undici": "6.28.0",
      "mocha@10.8.2>serialize-javascript": "7.0.5",
      "mocha@11.7.6>serialize-javascript": "7.0.5",
      "next@16.2.12>postcss": "8.5.25",
      "next@16.2.12>sharp": "0.35.0",
      "postcss@8.5.25>nanoid": "3.3.18",
      "number-to-bn@1.7.0>bn.js": "4.12.3",
      "solc@0.8.26>tmp": "0.2.7",
      "viem@2.23.2>ws": "8.21.0",
      "vite@8.2.0>yaml": "2.8.3"
    }
  }
}
