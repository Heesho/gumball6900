+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.26;
+
+import { IERC20 } from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import { stdError } from "forge-std/StdError.sol";
+
+import { SignalGBX } from "../../../src/core/SignalGBX.sol";
+import { ProtocolFixture } from "../utils/ProtocolFixture.sol";
+
+/// @title CEX03MembershipTransitionsTest
+/// @notice Proves that Resonance's address-only signal discovery metadata follows canonical paired-Bribe weights.
+contract CEX03MembershipTransitionsTest is ProtocolFixture {
+    function setUp() external {
+        _deployProtocol();
+    }
+
+    function test_FirstDuplicatePartialFinalAndReaddedMembershipTransitions() external {
+        uint256 principal = 100 ether;
+        _mintTestGBX(ALICE, principal);
+
+        vm.startPrank(ALICE);
+        gbx.approve(address(signalGBX), principal);
+        signalGBX.addSignal(address(targetStrategy), 20 ether);
+        vm.stopPrank();
+
+        assertEq(resonance.signalStrategyCount(ALICE), 1);
+        assertEq(resonance.signalStrategyAt(ALICE, 0), address(targetStrategy));
+        assertEq(_accountSignalWeight(ALICE, address(targetStrategy)), 20 ether);
+
+        SignalGBX.Allocation[] memory duplicates = new SignalGBX.Allocation[](2);
+        duplicates[0] = SignalGBX.Allocation({ strategy: address(targetStrategy), amount: 10 ether });
+        duplicates[1] = SignalGBX.Allocation({ strategy: address(targetStrategy), amount: 20 ether });
+        vm.prank(ALICE);
+        signalGBX.addSignalMany(duplicates);
+
+        assertEq(resonance.signalStrategyCount(ALICE), 1);
+        assertEq(resonance.signalStrategyAt(ALICE, 0), address(targetStrategy));
+        assertEq(_accountSignalWeight(ALICE, address(targetStrategy)), 50 ether);
+        assertEq(signalGBX.balanceOf(ALICE), 50 ether);
+
+        vm.prank(ALICE);
+        signalGBX.removeSignal(address(targetStrategy), 20 ether);
+
+        assertEq(resonance.signalStrategyCount(ALICE), 1);
+        assertEq(resonance.signalStrategyAt(ALICE, 0), address(targetStrategy));
+        assertEq(_accountSignalWeight(ALICE, address(targetStrategy)), 30 ether);
+
+        vm.prank(ALICE);
+        signalGBX.removeSignal(address(targetStrategy), 30 ether);
+
+        assertEq(resonance.signalStrategyCount(ALICE), 0);
+        assertEq(_accountSignalWeight(ALICE, address(targetStrategy)), 0);
+        assertEq(signalGBX.balanceOf(ALICE), 0);
+        assertEq(gbx.balanceOf(ALICE), principal);
+
+        vm.startPrank(ALICE);
+        gbx.approve(address(signalGBX), 25 ether);
+        signalGBX.addSignal(address(targetStrategy), 25 ether);
+        vm.stopPrank();
+
+        assertEq(resonance.signalStrategyCount(ALICE), 1);
+        assertEq(resonance.signalStrategyAt(ALICE, 0), address(targetStrategy));
+        assertEq(_accountSignalWeight(ALICE, address(targetStrategy)), 25 ether);
+
+        vm.prank(ALICE);
+        signalGBX.removeSignal(address(targetStrategy), 25 ether);
+
+        assertEq(resonance.signalStrategyCount(ALICE), 0);
+        assertEq(signalGBX.balanceOf(ALICE), 0);
+        assertEq(gbx.balanceOf(address(signalGBX)), 0);
+        assertEq(gbx.balanceOf(ALICE), principal);
+    }
+
+    function test_MultipleStrategiesUseSwapAndPopWithoutLosingAnotherMembership() external {
+        (address thirdStrategy,,) = resonance.addStrategy(IERC20(address(secondAsset)), defaultConfig());
+        uint256 principal = 60 ether;
+        _mintTestGBX(ALICE, principal);
+
+        vm.startPrank(ALICE);
+        gbx.approve(address(signalGBX), principal);
+        signalGBX.addSignal(address(targetStrategy), 10 ether);
+        signalGBX.addSignal(address(gbxStrategy), 20 ether);
+        signalGBX.addSignal(thirdStrategy, 30 ether);
+        vm.stopPrank();
+
+        assertEq(resonance.signalStrategyCount(ALICE), 3);
+        assertEq(resonance.signalStrategyAt(ALICE, 0), address(targetStrategy));
+        assertEq(resonance.signalStrategyAt(ALICE, 1), address(gbxStrategy));
+        assertEq(resonance.signalStrategyAt(ALICE, 2), thirdStrategy);
+
+        vm.prank(ALICE);
+        signalGBX.removeSignal(address(gbxStrategy), 20 ether);
+
+        assertEq(resonance.signalStrategyCount(ALICE), 2);
+        assertEq(resonance.signalStrategyAt(ALICE, 0), address(targetStrategy));
+        assertEq(resonance.signalStrategyAt(ALICE, 1), thirdStrategy);
+        assertEq(_accountSignalWeight(ALICE, address(gbxStrategy)), 0);
+        assertEq(_accountSignalWeight(ALICE, address(targetStrategy)), 10 ether);
+        assertEq(_accountSignalWeight(ALICE, thirdStrategy), 30 ether);
+
+        vm.startPrank(ALICE);
+        signalGBX.removeSignal(address(targetStrategy), 10 ether);
+        signalGBX.removeSignal(thirdStrategy, 30 ether);
+        vm.stopPrank();
+
+        assertEq(resonance.signalStrategyCount(ALICE), 0);
+        assertEq(signalGBX.balanceOf(ALICE), 0);
+        assertEq(gbx.balanceOf(address(signalGBX)), 0);
+        assertEq(gbx.balanceOf(ALICE), principal);
+    }
+
+    function test_AccountMembershipSetsRemainIsolatedForTheSameStrategy() external {
+        uint256 alicePrincipal = 40 ether;
+        uint256 bobPrincipal = 70 ether;
+        _mintTestGBX(ALICE, alicePrincipal);
+        _mintTestGBX(BOB, bobPrincipal);
+
+        vm.startPrank(ALICE);
+        gbx.approve(address(signalGBX), alicePrincipal);
+        signalGBX.addSignal(address(targetStrategy), alicePrincipal);
+        vm.stopPrank();
+
+        vm.startPrank(BOB);
+        gbx.approve(address(signalGBX), bobPrincipal);
+        signalGBX.addSignal(address(targetStrategy), bobPrincipal);
+        vm.stopPrank();
+
+        assertEq(resonance.signalStrategyCount(ALICE), 1);
+        assertEq(resonance.signalStrategyAt(ALICE, 0), address(targetStrategy));
+        assertEq(resonance.signalStrategyCount(BOB), 1);
+        assertEq(resonance.signalStrategyAt(BOB, 0), address(targetStrategy));
+        assertEq(targetBribe.signalWeightOf(ALICE), alicePrincipal);
+        assertEq(targetBribe.signalWeightOf(BOB), bobPrincipal);
+
+        vm.prank(ALICE);
+        signalGBX.removeSignal(address(targetStrategy), alicePrincipal);
+
+        assertEq(resonance.signalStrategyCount(ALICE), 0);
+        assertEq(targetBribe.signalWeightOf(ALICE), 0);
+        assertEq(resonance.signalStrategyCount(BOB), 1);
+        assertEq(resonance.signalStrategyAt(BOB, 0), address(targetStrategy));
+        assertEq(targetBribe.signalWeightOf(BOB), bobPrincipal);
+        assertEq(signalGBX.balanceOf(BOB), bobPrincipal);
+        assertEq(gbx.balanceOf(address(signalGBX)), bobPrincipal);
+
+        vm.prank(BOB);
+        signalGBX.removeSignal(address(targetStrategy), bobPrincipal);
+
+        assertEq(resonance.signalStrategyCount(BOB), 0);
+        assertEq(targetBribe.signalWeightOf(BOB), 0);
+        assertEq(signalGBX.totalSupply(), 0);
+        assertEq(gbx.balanceOf(address(signalGBX)), 0);
+        assertEq(gbx.balanceOf(ALICE), alicePrincipal);
+        assertEq(gbx.balanceOf(BOB), bobPrincipal);
+    }
+
+    function test_KilledStrategyRemainsDiscoverableUntilExactPrincipalExit() external {
+        uint256 principal = 77 ether;
+        _mintTestGBX(ALICE, principal);
+
+        vm.startPrank(ALICE);
+        gbx.approve(address(signalGBX), principal);
+        signalGBX.addSignal(address(targetStrategy), principal);
+        vm.stopPrank();
+
+        resonance.killStrategy(address(targetStrategy));
+
+        assertFalse(resonance.isStrategyLive(address(targetStrategy)));
+        assertEq(resonance.totalSignalWeight(), 0);
+        assertEq(resonance.signalStrategyCount(ALICE), 1);
+        assertEq(resonance.signalStrategyAt(ALICE, 0), address(targetStrategy));
+        assertEq(_accountSignalWeight(ALICE, address(targetStrategy)), principal);
+        assertEq(gbx.balanceOf(ALICE), 0);
+        assertEq(gbx.balanceOf(address(signalGBX)), principal);
+
+        vm.prank(ALICE);
+        signalGBX.removeSignal(address(targetStrategy), principal);
+
+        assertEq(resonance.signalStrategyCount(ALICE), 0);
+        assertEq(_accountSignalWeight(ALICE, address(targetStrategy)), 0);
+        assertEq(resonance.totalSignalWeight(), 0);
+        assertEq(signalGBX.balanceOf(ALICE), 0);
+        assertEq(gbx.balanceOf(address(signalGBX)), 0);
+        assertEq(gbx.balanceOf(ALICE), principal);
+    }
+
+    function test_SignalStrategyAtRevertsForEveryOutOfBoundsRead() external {
+        assertEq(resonance.signalStrategyCount(ALICE), 0);
+        vm.expectRevert(stdError.indexOOBError);
+        resonance.signalStrategyAt(ALICE, 0);
+
+        _mintTestGBX(ALICE, 1);
+        vm.startPrank(ALICE);
+        gbx.approve(address(signalGBX), 1);
+        signalGBX.addSignal(address(targetStrategy), 1);
+        vm.stopPrank();
+
+        vm.expectRevert(stdError.indexOOBError);
+        resonance.signalStrategyAt(ALICE, 1);
+
+        vm.prank(ALICE);
+        signalGBX.removeSignal(address(targetStrategy), 1);
+        vm.expectRevert(stdError.indexOOBError);
+        resonance.signalStrategyAt(ALICE, 0);
+    }
+}
