{
  "name": "@gumball-6900/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:deps": "pnpm --filter @gumball-6900/config --filter @gumball-6900/sdk --filter @gumball-6900/ui build",
    "prebuild": "pnpm run build:deps",
    "build": "next build",
    "clean": "rm -rf .next coverage playwright-report storybook-static test-results",
    "predev": "pnpm run build:deps",
    "dev": "next dev",
    "lint": "eslint . && tsc --noEmit",
    "start": "next start",
    "pretest": "pnpm run build:deps",
    "prestorybook": "pnpm run build:deps",
    "prestorybook:build": "pnpm run build:deps",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build --output-dir storybook-static",
    "test": "vitest run",
    "strategy-code:check": "node scripts/generate-strategy-creation-code.mjs --check",
    "strategy-code:generate": "node scripts/generate-strategy-creation-code.mjs",
    "pretest:e2e": "pnpm run build:deps && pnpm --dir ../../packages/contracts exec forge build",
    "test:e2e": "pnpm run test:e2e:routes && pnpm run test:e2e:rehearsal",
    "test:e2e:rehearsal": "playwright test --config playwright.rehearsal.config.ts",
    "test:e2e:routes": "playwright test --config playwright.config.ts",
    "pretypecheck": "pnpm run build:deps",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@gumball-6900/config": "workspace:*",
    "@gumball-6900/sdk": "workspace:*",
    "@gumball-6900/ui": "workspace:*",
    "@rainbow-me/rainbowkit": "2.2.11",
    "@tanstack/react-query": "5.101.4",
    "@x402/core": "2.19.0",
    "@x402/evm": "2.19.0",
    "@x402/extensions": "2.19.0",
    "@x402/svm": "2.19.0",
    "graphql-request": "7.4.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "viem": "2.55.10",
    "wagmi": "2.19.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.1",
    "@storybook/addon-a11y": "10.5.5",
    "@storybook/addon-docs": "10.5.5",
    "@storybook/nextjs-vite": "10.5.5",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.18.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "jsdom": "29.1.1",
    "storybook": "10.5.5",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.2",
    "vitest": "4.1.10"
  }
}
