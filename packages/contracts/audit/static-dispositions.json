  "reviewProfiles": {
    "read-only-slot-snapshot": {
      "reviewerId": "internal-protocol-security",
      "impact": "If auction quoting were expected to mutate a live slot, copying storage to memory could silently omit that state transition and misprice a replacement.",
      "exploitability": "_price is a view-only arithmetic helper and never writes its Slot argument; the replacement path deliberately quotes a previously copied Slot while the public price view copies the current storage Slot under normal Solidity memory conversion.",
      "affectedAssumptions": [
        "Auction quoting remains a pure read of initialPrice and auctionStartedAt plus the current timestamp.",
        "All slot mutations remain explicit in occupation, replacement, checkpoint, and capacity paths."
      ],
      "revisitTrigger": "Re-review if _price stops being read-only, accepts additional mutable state, or participates in slot checkpointing.",
      "compensatingControls": [
        "Boundary tests pin the start, hourly decay, terminal-zero, occupation, and replacement prices.",
        "State-machine invariants reconcile every live slot after arbitrary checkpoints and replacements."
      ]
    },
    "exact-boundaries": {
      "reviewerId": "internal-protocol-security",
      "impact": "Changing an exact zero, identity, or index boundary could skip accounting work or route value to the wrong liability class.",
      "exploitability": "Each reported equality is a documented state-machine sentinel for an empty amount, unchanged index, zero signal weight, or Strategy settlement branch.",
      "affectedAssumptions": ["Zero and equal-index states retain their documented accounting meanings."],
      "revisitTrigger": "Re-review if any reported sentinel, branch order, index transition, or zero-amount policy changes.",
      "compensatingControls": [
        "Boundary tests cover zero, one-unit, unchanged-index, and neighboring state transitions."
      ]
    },
    "transient-redemption-marks": {
      "reviewerId": "internal-protocol-security",
      "impact": "Incorrect transient-storage namespacing or clearing could admit duplicate redemption assets or couple independent redemptions in one transaction.",
      "exploitability": "The two assembly blocks contain only EIP-1153 tstore and tload for a domain-separated token key; every successful redemption clears each mark, while reverts discard transient state transactionally.",
      "affectedAssumptions": [
        "Robinhood Chain continues to support EIP-1153 semantics used by Solidity 0.8.26.",
        "The transient key domain and success-path clearing loop remain unchanged."
      ],
      "revisitTrigger": "Re-review if the key derivation, selected-token validation order, clearing loop, compiler, or target EVM version changes.",
      "compensatingControls": [
        "Tests cover duplicates in arbitrary order and multiple redemptions through one outer transaction.",
        "Fund redemption remains nonReentrant and rejects zero address and GBX before any burn."
      ]
    },
    "bounded-or-escapable-loops": {
      "reviewerId": "internal-protocol-security",
      "impact": "A caller-controlled external-call loop could make a required claim, redemption, or signal exit unavailable at practical chain gas limits.",
      "exploitability": "Reward-token loops are capped at sixteen and retain a scalar claim path; account strategy loops have scalar signal mutation paths; redemption is caller-selected by design.",
      "affectedAssumptions": [
        "Bribe reward registration remains capped at sixteen tokens in code.",
        "Scalar reward claims, incremental signal actions, and caller-selected redemption omission remain available."
      ],
      "revisitTrigger": "Re-review if a cap rises, a scalar/range escape path is removed, a loop body gains interaction, or chain transaction gas limits fall materially.",
      "compensatingControls": [
        "Maximum-sixteen-token gas tests measure entry, exit, move, and claim paths against the configured chain limit.",
        "Atomic revert is intentional for all-token convenience claims; a broken reward remains independently claimable through the scalar path once usable."
      ]
    },
    "guarded-callback-ordering": {
      "reviewerId": "internal-protocol-security",
      "impact": "A genuine reentrancy ordering flaw could duplicate claims, corrupt signal weights, or expose a partially registered Strategy graph.",
      "exploitability": "Reported value paths are nonReentrant; private functions inherit the active guard, constructor factory calls cannot reach a registered live graph, and state is advanced before supported-token interaction with atomic rollback.",
      "affectedAssumptions": [
        "Every public value-moving entry point retains nonReentrant coverage.",
        "Factories remain Resonance-controlled and deployed Strategies and Bribes retain immutable authorization links."
      ],
      "revisitTrigger": "Re-review on any external-call reordering, new callback-capable dependency, factory authorization change, or reentrancy-guard change.",
      "compensatingControls": [
        "Adversarial callback tests cover reward, revenue, contribution, purchase, signal, and redemption paths.",
        "Invariant campaigns require solvency, schedule, supply, weight, and custody balances to remain bounded after every action."
      ]
    },
    "protocol-time-boundaries": {
      "reviewerId": "internal-protocol-security",
      "impact": "Timestamp influence near a boundary could change an auction quote, emission epoch, deadline, or reward-stream accrual interval.",
      "exploitability": "Time is the intended input to the fixed auction, daily emission, seven-day stream, and deadline state machines; proposer influence cannot bypass price bounds, epoch ordering, caps, or exact accounting.",
      "affectedAssumptions": [
        "Robinhood Chain timestamps remain monotonic with normal Nitro sequencing behavior.",
        "No economic rule depends on sub-block timestamp precision."
      ],
      "revisitTrigger": "Re-review if durations, deadline semantics, timestamp source, stream arithmetic, or auction price bounds change.",
      "compensatingControls": ["Tests cover exact start, finish, overdue, empty-epoch, and adjacent timestamp cases."]
    },
    "revert-authoritative-calls": {
      "reviewerId": "internal-protocol-security",
      "impact": "Ignoring an authoritative return value could hide incomplete routing or use stale validation data.",
      "exploitability": "The reported calls use typed functions whose correctness is enforced by revert and by downstream exact balance checks; their returned convenience amount is not an independent source of truth.",
      "affectedAssumptions": [
        "The called functions continue to revert atomically on every incomplete or invalid operation."
      ],
      "revisitTrigger": "Re-review if a called ABI, return semantic, error behavior, or exact observed-delta validation changes.",
      "compensatingControls": [
        "Tests assert both successful exact deltas and rollback for every rejected supported-token behavior."
      ]
    },
    "minimal-external-administration": {
      "reviewerId": "internal-protocol-security",
      "impact": "Compromise of the Resonance setup owner or future external governance executor could change Strategy membership, reward-token registration, the prospective automatic-Bribe share, or Resonance ownership.",
      "exploitability": "These findings identify the intended remaining administrative surface: Resonance ownership, including the globally bounded 0% through 20% prospective Bribe-share setter, plus factories and SignalGBX wired immutably to Resonance; deployment remains blocked until the exact external governance executor and its permission and upgrade model are reviewed.",
      "affectedAssumptions": [
        "The signed deployment procedure transfers Resonance ownership to the reviewed external governance executor before protocol use and removes temporary setup authority.",
        "setBribeBps remains owner-only, uniform across Strategies, bounded from 0 through 2,000 basis points, prospective only, and unable to reprice any prior per-payment split."
      ],
      "revisitTrigger": "Re-review when an external governance system is selected or if ownership wiring, factory callers, SignalGBX controller, Bribe-share bounds or snapshot semantics, or the Resonance administrative surface changes.",
      "compensatingControls": [
        "Access-control and rate-transition tests enumerate privileged callers, exact bounds, prospective snapshots, and zero-rate liveness.",
        "The release checklist blocks launch evidence until the external governance integration and ownership transfer are independently verified."
      ]
    },
    "fixed-literals-and-abi-shape": {
      "reviewerId": "internal-protocol-security",
      "impact": "A mistaken fixed-point literal, ABI tuple slot, or shadowed constructor input could encode the wrong economics or position identity.",
      "exploitability": "Reported numeric values are named immutable protocol constants; tuple indices match the pinned Uniswap v4 position ABI; shadowed names are explicitly qualified or isolated constructor parameters.",
      "affectedAssumptions": [
        "Pinned emission, supply, precision, Uniswap fee, and price constants remain byte-for-byte reviewed values.",
        "The pinned PositionManager tuple shape remains unchanged for the selected dependency version."
      ],
      "revisitTrigger": "Re-review if any constant, fixed-point unit, tuple shape, dependency version, or constructor field name changes.",
      "compensatingControls": [
        "Constant-vector, deployment-wiring, pool-key, position-shape, and economic model tests pin the reported values."
      ]
    },
    "intentional-interface-shape": {
      "reviewerId": "internal-protocol-security",
      "impact": "Unused-looking ABI parameters or public views could be removed incorrectly and break canonical interfaces or permissionless monitoring.",
      "exploitability": "ERC-721 receiver parameter names are retained for generated ABI documentation while authorization deliberately ignores them; public preview and custody views are composability surfaces; loop counters use Solidity zero initialization.",
      "affectedAssumptions": [
        "IERC721Receiver selector and parameter order remain canonical.",
        "Permissionless accounting previews and custody health views remain supported API surface."
      ],
      "revisitTrigger": "Re-review if the receiver ABI, parameter authorization, public monitoring API, or zero-initialized local type changes.",
      "compensatingControls": [
        "Interface, custody, duplicate-selection, and empty/full-loop tests cover the reported declaration shapes."
      ]
    }
  },
