# Safe default: deterministic read-model data, wallet reads disabled, writes disabled.
# `live` is release-approved mainnet only. `testnet` is a remote chain-46630 testnet-candidate.
# `rehearsal` is reserved for the localhost-only Playwright fixture and is rejected in production.
GUMBALL_CLIENT_MODE=demo
GUMBALL_CHAIN_ID=4663

# Live and remote testnet modes require every value below. RPC and subgraph URLs must be remote HTTPS endpoints.
# Live requires a non-public production RPC plus a release-approved manifest whose signer policy matches the
# release-commit-embedded trust root. Testnet requires chain 46630 plus a validated signed testnet-candidate manifest,
# canonical testnet USDG/WETH, and the configured testnet Permit2. The trust root is not configurable here.
GUMBALL_RPC_URL=
# Required in live and remote testnet modes: one to four ordered, independent HTTPS fallback providers.
# Local rehearsal may leave this as an empty array.
GUMBALL_RPC_FALLBACK_URLS_JSON=[]
GUMBALL_PROTOCOL_ADDRESSES_JSON=
GUMBALL_STRATEGIES_JSON=
GUMBALL_REWARDS_JSON=
GUMBALL_DEPLOYMENT_MANIFEST_JSON=
GUMBALL_SUBGRAPH_URL=
