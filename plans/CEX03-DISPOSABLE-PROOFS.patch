index 0000000..5a9e57d
--- /dev/null
+++ b/packages/contracts/test/minimal/audit-gauntlet/CEX03FaultFuzzProof.t.sol
@@ -0,0 +1,176 @@
+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.26;
+
+import { Bribe } from "../../../src/core/Bribe.sol";
+import { ProtocolFixture } from "../utils/ProtocolFixture.sol";
+
+/// @title CEX03FaultFuzzProof
+/// @notice Disposable pre-approval proof for graph-local signal membership and scalar exit independence.
+contract CEX03FaultFuzzProof is ProtocolFixture {
+    uint256 private constant INITIAL_GBX = 1_000_000 ether;
+    uint256 private constant SIGNAL_STRATEGIES_SLOT = 17;
+
+    function setUp() external {
+        _deployProtocol();
+        _mintTestGBX(ALICE, INITIAL_GBX);
+
+        vm.prank(ALICE);
+        gbx.approve(address(signalGBX), type(uint256).max);
+    }
+
+    function test_AbsentMembershipCannotBlockScalarFinalExitAndLaterAddRepairsIt() external {
+        uint256 amount = 123 ether;
+        vm.prank(ALICE);
+        signalGBX.addSignal(address(targetStrategy), amount);
+
+        assertEq(resonance.signalStrategyCount(ALICE), 1);
+        assertEq(resonance.signalStrategyAt(ALICE, 0), address(targetStrategy));
+        assertEq(targetBribe.signalWeightOf(ALICE), amount);
+
+        bytes32 setBase = keccak256(abi.encode(ALICE, SIGNAL_STRATEGIES_SLOT));
+        bytes32 positionSlot =
+            keccak256(abi.encode(bytes32(uint256(uint160(address(targetStrategy)))), uint256(setBase) + 1));
+
+        // Simulate one logically absent member, not arbitrary EnumerableSet structural corruption.
+        vm.store(address(resonance), setBase, bytes32(0));
+        vm.store(address(resonance), positionSlot, bytes32(0));
+
+        assertEq(resonance.signalStrategyCount(ALICE), 0);
+        assertEq(targetBribe.signalWeightOf(ALICE), amount);
+
+        uint256 beforeExit = gbx.balanceOf(ALICE);
+        vm.prank(ALICE);
+        signalGBX.removeSignal(address(targetStrategy), amount);
+
+        assertEq(gbx.balanceOf(ALICE), beforeExit + amount);
+        assertEq(gbx.balanceOf(address(signalGBX)), 0);
+        assertEq(signalGBX.balanceOf(ALICE), 0);
+        assertEq(signalGBX.totalSupply(), 0);
+        assertEq(signalGBX.getVotes(ALICE), 0);
+        assertEq(targetBribe.signalWeightOf(ALICE), 0);
+        assertEq(targetBribe.totalSignalWeight(), 0);
+        assertEq(resonance.totalSignalWeight(), 0);
+        assertEq(resonance.signalStrategyCount(ALICE), 0);
+
+        vm.prank(ALICE);
+        signalGBX.addSignal(address(targetStrategy), amount);
+        assertEq(resonance.signalStrategyCount(ALICE), 1);
+        assertEq(resonance.signalStrategyAt(ALICE, 0), address(targetStrategy));
+
+        vm.prank(ALICE);
+        signalGBX.removeSignal(address(targetStrategy), amount);
+        assertEq(gbx.balanceOf(ALICE), INITIAL_GBX);
+        assertEq(resonance.signalStrategyCount(ALICE), 0);
+    }
+
+    function testFuzz_MembershipMatchesCanonicalWeightAndEverySequenceExits(uint256 seed) external {
+        for (uint256 i; i < 32; ++i) {
+            uint256 entropy = uint256(keccak256(abi.encode(seed, i)));
+            uint256 operation = entropy % 7;
+            address strategy = ((entropy >> 8) & 1) == 0 ? address(targetStrategy) : address(gbxStrategy);
+
+            if (operation <= 1) {
+                _addIfLive(strategy, entropy >> 16);
+            } else if (operation <= 3) {
+                _removeIfPresent(strategy, entropy >> 16);
+            } else if (operation == 4) {
+                _addIfLive(strategy, entropy >> 32);
+                _addIfLive(strategy, entropy >> 64);
+            } else if (operation == 5) {
+                if (resonance.isStrategyLive(address(targetStrategy)) && resonance.liveStrategyCount() > 1) {
+                    resonance.killStrategy(address(targetStrategy));
+                }
+            } else {
+                address other = strategy == address(targetStrategy) ? address(gbxStrategy) : address(targetStrategy);
+                uint256 weight = _accountSignalWeight(ALICE, strategy);
+                if (weight != 0 && resonance.isStrategyLive(other)) {
+                    vm.prank(ALICE);
+                    signalGBX.removeSignal(strategy, weight);
+                    vm.prank(ALICE);
+                    signalGBX.addSignal(other, weight);
+                }
+            }
+
+            _assertMembershipMatchesCanonicalWeights();
+        }
+
+        uint256 targetWeight = targetBribe.signalWeightOf(ALICE);
+        if (targetWeight != 0) {
+            vm.prank(ALICE);
+            signalGBX.removeSignal(address(targetStrategy), targetWeight);
+        }
+
+        uint256 gbxWeight = gbxBribe.signalWeightOf(ALICE);
+        if (gbxWeight != 0) {
+            vm.prank(ALICE);
+            signalGBX.removeSignal(address(gbxStrategy), gbxWeight);
+        }
+
+        assertEq(gbx.balanceOf(ALICE), INITIAL_GBX);
+        assertEq(gbx.balanceOf(address(signalGBX)), 0);
+        assertEq(signalGBX.balanceOf(ALICE), 0);
+        assertEq(signalGBX.totalSupply(), 0);
+        assertEq(signalGBX.getVotes(ALICE), 0);
+        assertEq(targetBribe.signalWeightOf(ALICE), 0);
+        assertEq(gbxBribe.signalWeightOf(ALICE), 0);
+        assertEq(resonance.totalSignalWeight(), 0);
+        assertEq(resonance.signalStrategyCount(ALICE), 0);
+    }
+
+    function _addIfLive(address strategy, uint256 entropy) private {
+        if (!resonance.isStrategyLive(strategy)) return;
+
+        uint256 available = gbx.balanceOf(ALICE);
+        if (available == 0) return;
+
+        uint256 amount = 1 + (entropy % (10 ether));
+        if (amount > available) amount = available;
+
+        vm.prank(ALICE);
+        signalGBX.addSignal(strategy, amount);
+    }
+
+    function _removeIfPresent(address strategy, uint256 entropy) private {
+        uint256 weight = _accountSignalWeight(ALICE, strategy);
+        if (weight == 0) return;
+
+        uint256 amount = ((entropy >> 64) & 1) == 0 ? weight : 1 + (entropy % weight);
+        vm.prank(ALICE);
+        signalGBX.removeSignal(strategy, amount);
+    }
+
+    function _assertMembershipMatchesCanonicalWeights() private view {
+        uint256 targetWeight = targetBribe.signalWeightOf(ALICE);
+        uint256 gbxWeight = gbxBribe.signalWeightOf(ALICE);
+        uint256 expectedCount = (targetWeight == 0 ? 0 : 1) + (gbxWeight == 0 ? 0 : 1);
+
+        assertEq(resonance.signalStrategyCount(ALICE), expectedCount);
+
+        bool sawTarget;
+        bool sawGbx;
+        for (uint256 i; i < expectedCount; ++i) {
+            address member = resonance.signalStrategyAt(ALICE, i);
+            if (member == address(targetStrategy)) {
+                assertFalse(sawTarget);
+                sawTarget = true;
+            } else {
+                assertEq(member, address(gbxStrategy));
+                assertFalse(sawGbx);
+                sawGbx = true;
+            }
+        }
+
+        assertEq(sawTarget, targetWeight != 0);
+        assertEq(sawGbx, gbxWeight != 0);
+
+        uint256 aggregate = targetWeight + gbxWeight;
+        assertEq(signalGBX.balanceOf(ALICE), aggregate);
+        assertEq(signalGBX.totalSupply(), aggregate);
+        assertEq(signalGBX.getVotes(ALICE), aggregate);
+        assertEq(gbx.balanceOf(address(signalGBX)), aggregate);
+
+        uint256 expectedActive = (resonance.isStrategyLive(address(targetStrategy)) ? targetWeight : 0)
+            + (resonance.isStrategyLive(address(gbxStrategy)) ? gbxWeight : 0);
+        assertEq(resonance.totalSignalWeight(), expectedActive);
+    }
+}
