{
  "name": "@gumball-6900/contracts",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "audit:install": "./audit/install-tools.sh",
    "audit:nightly": "./audit/run-nightly.sh",
    "audit:policy:test": "node --test audit/check-codeql-sarif.test.mjs audit/check-license-review.test.mjs audit/check-mythril-findings.test.mjs audit/check-pnpm-audit.test.mjs audit/check-static-findings.test.mjs audit/resolve-analyzer-environment.test.mjs audit/verify-toolchain.test.mjs scripts/archive-audit-reports.test.mjs",
    "audit:reports:coverage": "node scripts/archive-audit-reports.mjs coverage",
    "audit:reports:test": "node --test audit/check-codeql-sarif.test.mjs scripts/archive-audit-reports.test.mjs",
    "audit:static": "./audit/run-static.sh",
    "build": "pnpm run compile",
    "clean": "forge clean && rm -rf artifacts cache coverage typechain-types",
    "compile": "forge build && hardhat compile",
    "coverage": "forge coverage --report lcov && pnpm run coverage:check && hardhat coverage",
    "coverage:check": "node scripts/check-forge-coverage.mjs lcov.info",
    "coverage:policy:test": "node --test scripts/check-forge-coverage.test.mjs",
    "deploy:authorized": "pnpm --dir ../.. --filter @gumball-6900/config deployment:run --",
    "deploy:testnet": "pnpm --dir ../.. --filter @gumball-6900/config deployment:run:testnet --",
    "docs:check": "forge build && node scripts/generate-contract-docs.mjs --check",
    "docs:generate": "forge build && node scripts/generate-contract-docs.mjs",
    "fmt": "forge fmt",
    "fmt:check": "forge fmt --check",
    "lint": "solhint 'src/**/*.sol' 'script/foundry/**/*.sol' && forge fmt --check",
    "operator:production:plan:mainnet": "hardhat run --no-compile script/hardhat/prepare-production-execution.ts --network robinhoodForkPlanner",
    "operator:production:plan:testnet": "hardhat run --no-compile script/hardhat/prepare-production-execution.ts --network robinhoodTestnetForkPlanner",
    "prepare:local": "pnpm --dir ../.. --filter @gumball-6900/config deployment:prepare:local --",
    "release-observation:mainnet": "hardhat run --no-compile script/hardhat/revalidate-release-observation.ts --network robinhood",
    "release-observation:testnet": "hardhat run --no-compile script/hardhat/revalidate-release-observation.ts --network robinhoodTestnet",
    "emergency-guardian-safe:evidence:mainnet": "SAFE_CONTROL_PLANE_ROLE=emergency-guardian hardhat run script/hardhat/capture-safe-nonce-evidence.ts --network robinhood",
    "emergency-guardian-safe:evidence:testnet": "SAFE_CONTROL_PLANE_ROLE=emergency-guardian hardhat run script/hardhat/capture-safe-nonce-evidence.ts --network robinhoodTestnet",
    "protocol-admin-safe:evidence:mainnet": "SAFE_CONTROL_PLANE_ROLE=protocol-admin hardhat run script/hardhat/capture-safe-nonce-evidence.ts --network robinhood",
    "protocol-admin-safe:evidence:testnet": "SAFE_CONTROL_PLANE_ROLE=protocol-admin hardhat run script/hardhat/capture-safe-nonce-evidence.ts --network robinhoodTestnet",
    "snapshot": "forge snapshot",
    "test": "forge test",
    "test:gas": "forge test --gas-report",
    "test:hardhat": "forge build && hardhat test",
    "typecheck": "tsc --noEmit",
    "verify:mainnet": "hardhat run script/hardhat/verify-manifest.ts --network robinhood",
    "verify:testnet": "hardhat run script/hardhat/verify-manifest.ts --network robinhoodTestnet"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "@uniswap/v4-core": "1.0.2",
    "@uniswap/v4-periphery": "1.0.3"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "6.1.0",
    "@uniswap/v3-sdk": "3.31.1",
    "@types/chai": "4.3.20",
    "@types/mocha": "10.0.10",
    "@types/node": "22.18.0",
    "chai": "4.5.0",
    "esbuild": "0.25.12",
    "ethers": "6.17.0",
    "hardhat": "2.29.0",
    "solhint": "6.0.1",
    "solidity-coverage": "0.8.16",
    "ts-node": "10.9.2",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
}
